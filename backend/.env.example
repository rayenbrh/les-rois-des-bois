# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/les-rois-des-bois
MONGO_TEST_URI=mongodb://localhost:27017/les-rois-des-bois-test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads
PDF_PATH=./pdfs
MAX_FILE_SIZE=5242880

# AWS S3 Configuration (Optional - for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=les-rois-des-bois

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Les Rois des Bois <noreply@lesroisdebois.com>

# Company Information (for PDFs and invoices)
COMPANY_NAME=Les Rois des Bois
COMPANY_NAME_AR=ملوك الخشب
COMPANY_ADDRESS=123 Rue de la Forêt, Tunis, Tunisia
COMPANY_ADDRESS_AR=123 شارع الغابة، تونس، تونس
COMPANY_PHONE=+216 71 123 456
COMPANY_EMAIL=contact@lesroisdebois.com
COMPANY_TAX_ID=TN123456789
COMPANY_WEBSITE=www.lesroisdebois.com

# Tax Configuration
TAX_RATE=0.19
CURRENCY=TND
CURRENCY_SYMBOL=د.ت

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Image Processing
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400
IMAGE_QUALITY=80

# Invoice/Order Numbering
INVOICE_PREFIX=ROI-INV
ORDER_PREFIX=ROI-ORD
RECEIPT_PREFIX=ROI-REC

# Session/Security
SESSION_SECRET=your-session-secret-change-in-production
BCRYPT_ROUNDS=12

# Redis (Optional - for job queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentry/Error Tracking (Optional)
SENTRY_DSN=
